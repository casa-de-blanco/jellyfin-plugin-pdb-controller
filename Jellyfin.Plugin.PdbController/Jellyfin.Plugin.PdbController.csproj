<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Jellyfin 12.1 runs on .NET 10. The upstream plugin template is still
         on net9.0 / abi 10.11 and must not be copied verbatim. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PdbController</RootNamespace>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets=runtime on both: the server already has these loaded,
         and shipping a second copy into the plugin's AssemblyLoadContext is
         what trips PluginManager's GetTypes() probe and disables the plugin
         as NotSupported. For the same reason this project takes no other
         runtime dependency. See Kubernetes/KubernetesPdbClient.cs. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
